{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "cliId": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1
    },
    "accountScope": {
      "type": "string",
      "minLength": 1
    },
    "endpointFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "verifiedAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "releaseDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "releaseDateKind": {
      "enum": [
        "official",
        "reported",
        "unknown"
      ]
    },
    "visibility": {
      "enum": [
        "listed",
        "hidden",
        "unknown"
      ]
    },
    "availability": {
      "enum": [
        "accessible",
        "unavailable",
        "unknown"
      ]
    },
    "lifecycle": {
      "enum": [
        "active",
        "deprecated",
        "retired",
        "unverified"
      ]
    },
    "sunsetAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "replacementModelId": {
      "type": "string",
      "minLength": 1
    },
    "contextTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "maxOutputTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "modalities": {
      "type": "array",
      "items": {
        "enum": [
          "text",
          "image",
          "audio",
          "video"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "efforts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "selfDelegates": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "selfDelegates"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "costClass": {
          "enum": [
            "economy",
            "standard",
            "premium",
            "unknown"
          ]
        },
        "billing": {
          "enum": [
            "metered",
            "subscription",
            "local",
            "unknown"
          ]
        },
        "currency": {
          "const": "USD"
        },
        "inputPerMillion": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "outputPerMillion": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "costClass",
        "billing",
        "currency",
        "inputPerMillion",
        "outputPerMillion"
      ]
    },
    "dataUse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processing": {
          "enum": [
            "local",
            "remote",
            "unknown"
          ]
        },
        "productImprovement": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "retentionDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "processing",
        "productImprovement",
        "retentionDays"
      ]
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "qualified",
            "unqualified"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "fixtureDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "verifiedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "roles"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "qualified"
              }
            }
          },
          "then": {
            "required": [
              "fixtureDigest",
              "verifiedAt",
              "evidenceRef"
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "native",
              "official",
              "operator",
              "derived"
            ]
          },
          "observedAt": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "digest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "confidence": {
            "enum": [
              "verified",
              "reported",
              "derived",
              "unknown"
            ]
          }
        },
        "required": [
          "fields",
          "source",
          "kind",
          "observedAt",
          "digest",
          "confidence"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "firstObservedAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "fetchedAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "retiredAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersededBy": {
      "type": "string",
      "minLength": 1
    },
    "effortSupport": {
      "enum": [
        "explicit",
        "not-applicable",
        "unknown"
      ]
    }
  },
  "required": [
    "version",
    "recordId",
    "cliId",
    "family",
    "runtimeVersion",
    "accountScope",
    "endpointFingerprint",
    "observedAt",
    "verifiedAt",
    "releaseDate",
    "releaseDateKind",
    "visibility",
    "availability",
    "lifecycle",
    "contextTokens",
    "maxOutputTokens",
    "modalities",
    "efforts",
    "pricing",
    "dataUse",
    "qualification",
    "provenance",
    "firstObservedAt",
    "fetchedAt",
    "retiredAt",
    "effortSupport"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseDate": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "releaseDateKind": {
            "const": "unknown"
          }
        }
      },
      "else": {
        "properties": {
          "releaseDateKind": {
            "enum": [
              "official",
              "reported"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effortSupport": {
            "const": "explicit"
          }
        }
      },
      "then": {
        "properties": {
          "efforts": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "efforts": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
