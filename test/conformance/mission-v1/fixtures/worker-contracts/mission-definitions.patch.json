                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "artifactDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "controlledContext": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "findings": {
                "minItems": 1
