    "workerResolvedInvocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "direct",
            "managed"
          ]
        },
        "transport": {
          "enum": [
            "shell",
            "mcp"
          ]
        },
        "selected": {
          "$ref": "#/$defs/workerTuple"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "catalogDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "profileDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1048576
          },
          "minItems": 1,
          "maxItems": 512
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "stdin": {
          "enum": [
            "closed",
            "brief-text",
            "brief-json"
          ]
        },
        "briefPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "stdoutPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "stderrPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "finalPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "shellCommand": {
          "type": "string",
          "maxLength": 2097152
        },
        "envNames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serverRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "arguments": {
              "type": "object",
              "maxProperties": 64
            },
            "inputSchemaDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "outputSchemaDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "sessionIsolation": {
              "enum": [
                "per-call",
                "per-instance",
                "serialized"
              ]
            }
          },
          "required": [
            "serverRef",
            "tool",
            "arguments",
            "inputSchemaDigest",
            "timeoutSeconds",
            "outputSchemaDigest",
            "sessionIsolation"
          ]
        },
        "readiness": {
          "enum": [
            "preparatory",
            "launchable"
          ]
        },
        "briefDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "$ref": "#/$defs/workerLimits"
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "effectiveCaps": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "controlEvidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "health": {
          "$ref": "#/$defs/workerEffectiveHealth"
        }
      },
      "required": [
        "version",
        "mode",
        "transport",
        "selected",
        "policyDigest",
        "catalogDigest",
        "profileDigest",
        "expiresAt",
        "readiness",
        "briefDigest",
        "limits",
        "maxOutputBytes",
        "effectiveCaps",
        "controlEvidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "shell"
              }
            }
          },
          "then": {
            "required": [
              "argv",
              "cwd",
              "stdin",
              "shellCommand",
              "envNames",
              "finalPath",
              "briefPath",
              "stdoutPath",
              "stderrPath"
            ],
            "not": {
              "required": [
                "mcp"
              ]
            }
          },
          "else": {
            "required": [
              "mcp"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "shellCommand"
                  ]
                },
                {
                  "required": [
                    "argv"
                  ]
                },
                {
                  "required": [
                    "stdin"
                  ]
                },
                {
                  "required": [
                    "envNames"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "readiness": {
                "const": "launchable"
              }
            }
          },
          "then": {
            "properties": {
              "briefDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
