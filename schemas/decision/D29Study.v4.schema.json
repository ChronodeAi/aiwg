{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/D29Study.v4.schema.json",
  "title": "D29Study v4",
  "oneOf": [
    {
      "$ref": "https://aiwg.io/schemas/decision/D29Study.v3.schema.json"
    },
    {
      "$ref": "#/$defs/gold"
    },
    {
      "$ref": "#/$defs/audit"
    },
    {
      "$ref": "#/$defs/score"
    },
    {
      "$ref": "#/$defs/analysis"
    }
  ],
  "$defs": {
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "syntheticOnly",
        "rows"
      ],
      "properties": {
        "schemaVersion": {
          "const": "decision-d29-gold/v4"
        },
        "syntheticOnly": {
          "const": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "world",
              "gold",
              "variant"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "world": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "sourceAttribute",
                  "claimAttribute",
                  "sourceValue",
                  "claimValue",
                  "uncertain",
                  "injected",
                  "artifactPresent",
                  "testPassed",
                  "required",
                  "covered",
                  "variant",
                  "sourceModule",
                  "claimModule",
                  "exclusive",
                  "sourceValues",
                  "negatedValues",
                  "scoped",
                  "temporal",
                  "current",
                  "independent",
                  "complete",
                  "decoy",
                  "distractorCount",
                  "factPosition",
                  "nearMissGroup",
                  "injectionPhrase"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "citation",
                      "phase-criterion"
                    ]
                  },
                  "sourceAttribute": {
                    "enum": [
                      "port",
                      "protocol",
                      "region",
                      "owner-team",
                      "major-version",
                      "rollback",
                      "security",
                      "migration"
                    ]
                  },
                  "claimAttribute": {
                    "enum": [
                      "port",
                      "protocol",
                      "region",
                      "owner-team",
                      "major-version",
                      "rollback",
                      "security",
                      "migration"
                    ]
                  },
                  "sourceValue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claimValue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uncertain": {
                    "type": "boolean"
                  },
                  "injected": {
                    "type": "boolean"
                  },
                  "artifactPresent": {
                    "type": "boolean"
                  },
                  "testPassed": {
                    "type": "boolean"
                  },
                  "required": {
                    "type": "string",
                    "minLength": 1
                  },
                  "covered": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "variant": {
                    "enum": [
                      "exact",
                      "paraphrase",
                      "multi-value",
                      "negated",
                      "moved",
                      "exclusive-single",
                      "exclusive-restricted",
                      "scoped",
                      "temporal",
                      "tentative",
                      "different-nonexclusive",
                      "other-attribute",
                      "near-miss-digit",
                      "near-miss-transposition",
                      "context",
                      "prefix",
                      "middle",
                      "suffix",
                      "verified",
                      "checklist",
                      "explicit-none",
                      "planned",
                      "wrong-attribute",
                      "wrong-subject",
                      "stale",
                      "self-attested",
                      "partial",
                      "different-current"
                    ]
                  },
                  "sourceModule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claimModule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exclusive": {
                    "type": "boolean"
                  },
                  "sourceValues": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "negatedValues": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "scoped": {
                    "type": "boolean"
                  },
                  "temporal": {
                    "type": "boolean"
                  },
                  "current": {
                    "type": "boolean"
                  },
                  "independent": {
                    "type": "boolean"
                  },
                  "complete": {
                    "type": "boolean"
                  },
                  "decoy": {
                    "type": "boolean"
                  },
                  "distractorCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "factPosition": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "nearMissGroup": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 2
                  },
                  "injectionPhrase": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 15
                  }
                }
              },
              "gold": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ready",
                  "support"
                ],
                "properties": {
                  "ready": {
                    "type": "boolean"
                  },
                  "support": {
                    "enum": [
                      "supports",
                      "contradicts",
                      "unclear",
                      "does-not-support",
                      null
                    ]
                  }
                }
              },
              "variant": {
                "enum": [
                  "exact",
                  "paraphrase",
                  "multi-value",
                  "negated",
                  "moved",
                  "exclusive-single",
                  "exclusive-restricted",
                  "scoped",
                  "temporal",
                  "tentative",
                  "different-nonexclusive",
                  "other-attribute",
                  "near-miss-digit",
                  "near-miss-transposition",
                  "context",
                  "prefix",
                  "middle",
                  "suffix",
                  "verified",
                  "checklist",
                  "explicit-none",
                  "planned",
                  "wrong-attribute",
                  "wrong-subject",
                  "stale",
                  "self-attested",
                  "partial",
                  "different-current"
                ]
              }
            }
          },
          "minItems": 2000,
          "maxItems": 2000
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "splits",
        "n",
        "targets",
        "topRules",
        "passed",
        "pairFeatureLimit",
        "pairSelection",
        "featureFamilies",
        "modelLeakage"
      ],
      "properties": {
        "schemaVersion": {
          "const": "decision-d29-shortcut-audit/v2"
        },
        "splits": {
          "const": [
            "tuning",
            "calibration"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "positives",
              "negatives",
              "limit",
              "featureCount",
              "maximumBalancedAccuracy",
              "topRules",
              "pairFeatureCounts",
              "pairRuleCount",
              "maximumSingleBalancedAccuracy",
              "maximumPairBalancedAccuracy",
              "topSingleRules",
              "topPairRules"
            ],
            "properties": {
              "target": {
                "enum": [
                  "injection",
                  "readiness",
                  "supports",
                  "contradicts",
                  "unclear",
                  "does-not-support"
                ]
              },
              "positives": {
                "type": "integer",
                "minimum": 1
              },
              "negatives": {
                "type": "integer",
                "minimum": 1
              },
              "limit": {
                "enum": [
                  0.75,
                  0.8
                ]
              },
              "featureCount": {
                "type": "integer",
                "minimum": 1
              },
              "maximumBalancedAccuracy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "topRules": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/rule"
                },
                "minItems": 10,
                "maxItems": 10
              },
              "pairFeatureCounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "view",
                    "count"
                  ],
                  "properties": {
                    "view": {
                      "enum": [
                        "passage",
                        "passage-and-context",
                        "context"
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 200
                    }
                  }
                },
                "minItems": 3
              },
              "pairRuleCount": {
                "type": "integer",
                "minimum": 0
              },
              "maximumSingleBalancedAccuracy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maximumPairBalancedAccuracy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "topSingleRules": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/rule"
                },
                "minItems": 1
              },
              "topPairRules": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/rule"
                },
                "minItems": 0
              }
            }
          },
          "minItems": 6,
          "maxItems": 6
        },
        "topRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 10,
          "maxItems": 10
        },
        "passed": {
          "type": "boolean"
        },
        "pairFeatureLimit": {
          "const": 200
        },
        "pairSelection": {
          "const": "strongest-single-distinct-bitsets-per-target-and-view"
        },
        "featureFamilies": {
          "const": [
            "tokens-including-stopwords",
            "bigrams",
            "annotation-counts",
            "sentence-counts",
            "formatting-counts",
            "character-thresholds",
            "length-bins"
          ]
        },
        "modelLeakage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "view",
            "vocabulary",
            "informationalOnly",
            "maximumBalancedAccuracy",
            "targets"
          ],
          "properties": {
            "method": {
              "const": "stratified-5-fold-depth-3-balanced-tree"
            },
            "view": {
              "const": "passage-and-context"
            },
            "vocabulary": {
              "const": "training-fold-only-token-presence-minimum-two"
            },
            "informationalOnly": {
              "const": true
            },
            "maximumBalancedAccuracy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "balancedAccuracy",
                  "validationCount",
                  "folds"
                ],
                "properties": {
                  "target": {
                    "enum": [
                      "injection",
                      "readiness",
                      "supports",
                      "contradicts",
                      "unclear",
                      "does-not-support"
                    ]
                  },
                  "balancedAccuracy": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "validationCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "folds": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "fold",
                        "trainingCount",
                        "validationCount",
                        "vocabularyCount"
                      ],
                      "properties": {
                        "fold": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4
                        },
                        "trainingCount": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "validationCount": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "vocabularyCount": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "minItems": 5
                  }
                }
              },
              "minItems": 6
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "view",
        "feature",
        "polarity",
        "balancedAccuracy",
        "operator"
      ],
      "properties": {
        "target": {
          "enum": [
            "injection",
            "readiness",
            "supports",
            "contradicts",
            "unclear",
            "does-not-support"
          ]
        },
        "view": {
          "enum": [
            "passage",
            "passage-and-context",
            "context"
          ]
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "polarity": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "balancedAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "operator": {
          "enum": [
            "single",
            "AND",
            "OR"
          ]
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decision",
        "native",
        "external",
        "heldout",
        "provenance",
        "reviewerN",
        "missingInputs",
        "completeCase",
        "failureAsError",
        "proposedStatisticalDisposition",
        "limitations",
        "groups"
      ],
      "properties": {
        "schemaVersion": {
          "const": "decision-d29-score/v4"
        },
        "decision": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/decision"
        },
        "native": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/native"
        },
        "external": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/external"
        },
        "heldout": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/heldout"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "receiptDigest",
              "attempts",
              "mappingDigest",
              "baseline",
              "baselineDigest",
              "reservationUsdMicros",
              "secondaryBaseline",
              "secondaryBaselineDigest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "receiptDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "attempts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "mappingDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "baseline": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "route",
                  "support"
                ],
                "properties": {
                  "route": {
                    "enum": [
                      "ADVISORY_READY",
                      "REVIEW"
                    ]
                  },
                  "support": {
                    "enum": [
                      "supports",
                      "contradicts",
                      "unclear",
                      "does-not-support",
                      null
                    ]
                  }
                }
              },
              "baselineDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "reservationUsdMicros": {
                "type": "integer",
                "minimum": 0
              },
              "secondaryBaseline": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "route",
                  "support"
                ],
                "properties": {
                  "route": {
                    "enum": [
                      "ADVISORY_READY",
                      "REVIEW"
                    ]
                  },
                  "support": {
                    "enum": [
                      "supports",
                      "contradicts",
                      "unclear",
                      "does-not-support",
                      null
                    ]
                  }
                }
              },
              "secondaryBaselineDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        },
        "reviewerN": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/reviewerN"
        },
        "missingInputs": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/missingInputs"
        },
        "completeCase": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/completeCase"
        },
        "failureAsError": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/failureAsError"
        },
        "proposedStatisticalDisposition": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/proposedStatisticalDisposition"
        },
        "limitations": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/score/oneOf/0/properties/limitations"
        },
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slices",
            "variants"
          ],
          "properties": {
            "slices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/group"
              },
              "minItems": 1
            },
            "variants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/group"
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice",
        "variant",
        "n",
        "missingCandidate",
        "candidate",
        "baseline",
        "secondaryBaseline"
      ],
      "properties": {
        "slice": {
          "enum": [
            "citation-supports",
            "citation-contradicts",
            "citation-unclear",
            "citation-does-not-support",
            "citation-injection",
            "criterion-ready",
            "criterion-incomplete",
            "criterion-injection",
            "missing-artifact",
            "failed-test"
          ]
        },
        "variant": {
          "enum": [
            "exact",
            "paraphrase",
            "multi-value",
            "negated",
            "moved",
            "exclusive-single",
            "exclusive-restricted",
            "scoped",
            "temporal",
            "tentative",
            "different-nonexclusive",
            "other-attribute",
            "near-miss-digit",
            "near-miss-transposition",
            "context",
            "prefix",
            "middle",
            "suffix",
            "verified",
            "checklist",
            "explicit-none",
            "planned",
            "wrong-attribute",
            "wrong-subject",
            "stale",
            "self-attested",
            "partial",
            null,
            "different-current"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "missingCandidate": {
          "type": "integer",
          "minimum": 0
        },
        "candidate": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/groupMetrics"
        },
        "baseline": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/groupMetrics"
        },
        "secondaryBaseline": {
          "$ref": "https://aiwg.io/schemas/decision/D29Study.v2.schema.json#/$defs/groupMetrics"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "syntheticOnly",
        "splits",
        "native",
        "external",
        "calibration",
        "review",
        "missingPolicy",
        "conditionalRates",
        "comparators",
        "shortcutAudit"
      ],
      "properties": {
        "schemaVersion": {
          "const": "decision-d29-analysis/v3"
        },
        "syntheticOnly": {
          "const": true
        },
        "splits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "ids",
              "digest"
            ],
            "properties": {
              "name": {
                "enum": [
                  "tuning",
                  "calibration",
                  "test"
                ]
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "native": {
          "$ref": "https://aiwg.io/schemas/decision/SdlcScreeningPreregistration.v1.schema.json"
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumAcceptedCoverageLowerBps",
            "maximumBlockingSliceFalseReadyEvents",
            "maximumBlockingSliceFalseReadyUpperBps"
          ],
          "properties": {
            "minimumAcceptedCoverageLowerBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maximumBlockingSliceFalseReadyEvents": {
              "type": "integer",
              "minimum": 0
            },
            "maximumBlockingSliceFalseReadyUpperBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "minimumCellN",
            "smoothing",
            "split",
            "profile"
          ],
          "properties": {
            "method": {
              "const": "kind-and-safe-semantic-ready-frequency-v2"
            },
            "minimumCellN": {
              "type": "integer",
              "minimum": 1
            },
            "smoothing": {
              "const": "laplace-1"
            },
            "split": {
              "const": "calibration"
            },
            "profile": {
              "$ref": "https://aiwg.io/schemas/decision/CalibrationArtifact.v1.schema.json#/properties/profile"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "development",
            "holdout",
            "delayedRepeats",
            "reviewer"
          ],
          "properties": {
            "development": {
              "const": 50
            },
            "holdout": {
              "const": 100
            },
            "delayedRepeats": {
              "const": 15
            },
            "reviewer": {
              "const": "roctinam"
            }
          }
        },
        "missingPolicy": {
          "const": "withhold-native-report; complete-case-description; missing-as-error"
        },
        "conditionalRates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "comparators": {
          "type": "object",
