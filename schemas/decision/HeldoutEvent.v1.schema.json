{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/HeldoutEvent.v1.schema.json",
  "title": "HeldoutEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "previous",
    "attempt",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "decision-heldout-event/v1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "$ref": "HeldoutAttempt.v1.schema.json"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
