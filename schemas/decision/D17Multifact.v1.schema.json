{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/D17Multifact.v1.schema.json",
  "title": "D17Multifact",
  "description": "D17-MF calibrated multi-fact probe (#2850): analysis and protocol, development review (template and completed), shortcut audit and report.",
