{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/PreprocessedEvidence.v1.schema.json",
  "title": "AIWG Preprocessed Evidence v1",
  "description": "Default-off manifest for text decision input derived from non-text sources. It records source identity, ordered preprocessing, output identity, locators, quality, transformations, trust, lifecycle and independent raw/derived egress controls.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "decision.aiwg.io/v1alpha2" },
    "kind": { "const": "PreprocessedEvidence" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": [
        "source", "preprocessing", "output", "segments", "selectedSegments",
        "quality", "transformations", "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "preprocessing": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "output": { "$ref": "#/$defs/output" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/segment" }
        },
        "selectedSegments": {
          "description": "Each segment may be selected once. uniqueItems rejects exact duplicates; the resolver also rejects a repeated segmentId.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/selectedSegment" }
        },
        "quality": { "$ref": "#/$defs/quality" },
        "transformations": {
          "type": "array",
          "items": { "$ref": "#/$defs/transformationEvent" }
        },
        "policy": { "$ref": "#/$defs/policy" }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["id", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "locator": {
      "type": "object",
      "required": ["class", "value"],
      "additionalProperties": false,
      "properties": {
        "class": { "enum": ["opaque-id", "artifact-ref", "local-redacted", "remote-url"] },
        "value": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "assetId", "contentDigest", "mediaType", "sizeBytes", "acquiredAt",
        "locator", "classification"
      ],
      "additionalProperties": false,
      "properties": {
        "assetId": { "$ref": "#/$defs/nonEmpty" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "mediaType": { "$ref": "#/$defs/nonEmpty" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "acquiredAt": { "$ref": "#/$defs/dateTime" },
        "locator": { "$ref": "#/$defs/locator" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "license": { "$ref": "#/$defs/nonEmpty" },
        "consent": { "$ref": "#/$defs/nonEmpty" },
        "classification": { "$ref": "#/$defs/classification" }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id", "ordinal", "kind", "tool", "configurationDigest", "runtime",
        "startedAt", "endedAt", "inputDigest", "outputDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": [
            "ocr", "asr", "caption", "image-description", "normalization",
            "redaction", "translation", "truncation", "summary", "concatenation"
          ]
        },
        "tool": {
          "type": "object",
          "required": ["id", "version"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/nonEmpty" },
            "version": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "model": {
          "type": "object",
          "required": ["id", "version"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/nonEmpty" },
            "version": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "configurationDigest": { "$ref": "#/$defs/digest" },
        "runtime": { "enum": ["recorded-fixture", "offline", "live-observed"] },
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "endedAt": { "$ref": "#/$defs/dateTime" },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "outputDigest": { "$ref": "#/$defs/digest" },
        "noOp": {
          "description": "Required exactly when the step is an identity transform (inputDigest equals outputDigest). Not allowed on extraction steps.",
          "const": true
        },
        "notesDigest": { "$ref": "#/$defs/digest" }
      },
      "if": { "properties": { "kind": { "enum": ["ocr", "asr", "caption", "image-description"] } }, "required": ["kind"] },
      "then": { "properties": { "noOp": false } }
    },
    "output": {
      "type": "object",
      "required": ["id", "version", "contentDigest", "language", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "version": { "type": "integer", "minimum": 1 },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "language": { "$ref": "#/$defs/nonEmpty" },
        "value": { "type": "string" },
        "reference": { "$ref": "#/$defs/locator" }
      }
    },
    "locatorRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 },
        "frame": { "type": "integer", "minimum": 0 },
        "wholeImage": { "type": "boolean", "const": true },
        "bbox": {
          "type": "object",
          "required": ["x", "y", "width", "height", "unit"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 },
            "unit": { "enum": ["pixel", "ratio"] }
          }
        }
      },
      "anyOf": [
        { "properties": { "page": true }, "required": ["page"] },
        { "properties": { "startMs": true, "endMs": true }, "required": ["startMs", "endMs"] },
        { "properties": { "frame": true }, "required": ["frame"] },
        { "properties": { "bbox": true }, "required": ["bbox"] },
        { "properties": { "wholeImage": true }, "required": ["wholeImage"] }
      ]
    },
    "segment": {
      "type": "object",
      "required": ["id", "ordinal", "sourceLocator", "outputRange", "text", "textDigest"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "sourceLocator": { "$ref": "#/$defs/locatorRange" },
        "outputRange": {
          "description": "UTF-8 byte range [start, end) of the segment inside the digest-verified output value. The resolver requires text to equal this slice and projects the slice.",
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        },
        "text": { "type": "string" },
        "textDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "selectedSegment": {
      "type": "object",
      "required": ["segmentId", "outputVersion", "outputDigest"],
      "additionalProperties": false,
      "properties": {
        "segmentId": { "$ref": "#/$defs/nonEmpty" },
        "outputVersion": { "type": "integer", "minimum": 1 },
        "outputDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "quality": {
      "type": "object",
      "required": ["source", "profile", "label", "score", "flags"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["preprocessor", "human-reviewer"] },
        "profile": { "$ref": "#/$defs/nonEmpty" },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "flags": {
          "type": "array",
          "items": { "enum": ["low-quality", "truncated", "incomplete", "stale", "policy-limited", "human-corrected"] }
        }
      }
    },
    "transformationEvent": {
      "type": "object",
      "required": ["id", "kind", "inputDigest", "outputDigest", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "kind": {
          "enum": ["normalization", "redaction", "translation", "truncation", "human-correction", "summary", "concatenation"]
        },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "outputDigest": { "$ref": "#/$defs/digest" },
        "at": { "$ref": "#/$defs/dateTime" },
        "reviewer": { "$ref": "#/$defs/nonEmpty" },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "previousOutput": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/nonEmpty" },
            "version": { "type": "integer", "minimum": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "human-correction" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "reviewer": true,
              "rationale": true,
              "previousOutput": true
            },
            "required": ["reviewer", "rationale", "previousOutput"]
          }
        }
      ]
    },
    "egressDestination": {
      "type": "object",
      "required": ["provider", "origin"],
      "additionalProperties": false,
      "properties": {
        "provider": { "$ref": "#/$defs/nonEmpty" },
        "origin": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "egressRule": {
      "type": "object",
      "required": ["allowed", "destinations"],
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/egressDestination" }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["trust", "sensitivity", "retention", "residency", "rawEgress", "derivedEgress"],
      "additionalProperties": false,
      "properties": {
        "trust": { "enum": ["verified", "untrusted"] },
        "sensitivity": { "$ref": "#/$defs/classification" },
        "retention": { "$ref": "#/$defs/nonEmpty" },
        "residency": { "$ref": "#/$defs/nonEmpty" },
        "rawEgress": { "$ref": "#/$defs/egressRule" },
        "derivedEgress": { "$ref": "#/$defs/egressRule" }
      }
    }
  }
}
