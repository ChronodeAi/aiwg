{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/ContextPruningPreregistration.v1.schema.json",
  "title": "Context Pruning Preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "registeredAt",
    "pairSetDigest",
    "thresholds",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "decision-context-pruning-preregistration/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time"
    },
    "pairSetDigest": {
      "$ref": "#/$defs/digest"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedRetentionBps",
        "confidenceInterval",
        "qualityMetrics",
        "slices",
        "minimumOverallN",
        "minimumSliceN",
        "powerRule",
        "qualityNonInferiorityMarginBps",
        "positiveTotalTokenTarget",
        "positiveTotalCostTargetUsd"
      ],
      "properties": {
        "protectedRetentionBps": {
          "const": 10000
        },
        "confidenceInterval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "levelBps",
            "binaryMethod",
            "boundedMethod",
            "bootstrapSeed",
            "bootstrapResamples"
          ],
          "properties": {
            "levelBps": {
              "type": "integer",
              "exclusiveMinimum": 5000,
              "exclusiveMaximum": 9999
            },
            "binaryMethod": {
              "enum": [
                "newcombe-10",
                "tango"
              ]
            },
            "boundedMethod": {
              "const": "percentile-bootstrap"
            },
            "bootstrapSeed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "bootstrapResamples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "qualityMetrics": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "scale"
            ],
            "properties": {
              "metric": {
                "enum": [
                  "downstream-task-success",
                  "requirement-coverage",
                  "factual-coverage",
                  "citation-accuracy",
                  "human-preference"
                ]
              },
              "scale": {
                "enum": [
                  "binary",
                  "bounded"
                ]
              }
            }
          }
        },
        "slices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimumOverallN": {
          "type": "integer",
          "minimum": 2
        },
        "minimumSliceN": {
          "type": "integer",
          "minimum": 1
        },
        "powerRule": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualityNonInferiorityMarginBps": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 0
        },
        "positiveTotalTokenTarget": {
          "type": "integer",
          "minimum": 1
        },
        "positiveTotalCostTargetUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
