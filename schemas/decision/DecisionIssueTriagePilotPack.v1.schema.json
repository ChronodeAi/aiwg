{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/DecisionIssueTriagePilotPack.v1.schema.json",
  "title": "DecisionIssueTriagePilotPack.v1",
  "description": "Governed, default-off issue triage shadow pilot pack. The pack defines closed taxonomies and may only produce evaluation artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "mode",
    "taxonomies",
    "urgencyRubric",
    "candidatePolicy",
    "acceptance",
    "trackerMutationPolicy",
    "rollback"
  ],
  "properties": {
    "schemaVersion": { "const": "decision-issue-triage-pilot-pack/v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["disabled", "offline-shadow", "advisory"] },
    "taxonomies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueTypes", "areas", "stateCompleteness", "clarificationNeed"],
      "properties": {
        "issueTypes": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "areas": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "stateCompleteness": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["complete", "partial", "missing"] }
        },
        "clarificationNeed": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["needed", "not-needed"] }
        }
      }
    },
    "urgencyRubric": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ordinal", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ordinal": { "type": "integer", "minimum": 0 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "candidatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "maxCandidates", "includeNone"],
      "properties": {
        "generator": { "const": "deterministic-token-overlap-v1" },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 20 },
        "includeNone": { "const": true }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertaintyProfiles", "calibration", "acceptedScoring"],
      "properties": {
        "uncertaintyProfiles": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "calibration": { "enum": ["advisory", "required"] },
        "acceptedScoring": { "enum": ["disabled-on-incompatibility"] }
      }
    },
    "trackerMutationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "edit", "label", "assign", "comment", "close", "merge"],
      "properties": {
        "create": { "const": "forbidden" },
        "edit": { "const": "forbidden" },
        "label": { "const": "forbidden" },
        "assign": { "const": "forbidden" },
        "comment": { "const": "forbidden" },
        "close": { "const": "forbidden" },
        "merge": { "const": "forbidden" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disableRestoresPriorWorkflow", "preserveReceiptsAndLabels"],
      "properties": {
        "disableRestoresPriorWorkflow": { "const": true },
        "preserveReceiptsAndLabels": { "const": true }
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
