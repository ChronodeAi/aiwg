{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/SdlcScreeningPreregistration.v1.schema.json",
  "title": "SdlcScreeningPreregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "frozenAt",
    "heldoutSplitDigest",
    "slices",
    "gateBlockingSlices",
    "maximumFalseSupportRateBps",
    "maximumFalseReadyRateBps",
    "minimumTotalSupport",
    "minimumSliceSupport",
    "minimumGateBlockingSliceSupport",
    "confidenceInterval",
    "qualityNonInferiorityBps",
    "efficiencyClaim"
  ],
  "properties": {
    "schemaVersion": {
      "const": "decision-sdlc-screening-preregistration/v1"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time"
    },
    "heldoutSplitDigest": {
      "$ref": "#/$defs/digest"
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stringId"
      }
    },
    "gateBlockingSlices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stringId"
      }
    },
    "maximumFalseSupportRateBps": {
      "$ref": "#/$defs/bps"
    },
    "maximumFalseReadyRateBps": {
      "$ref": "#/$defs/bps"
    },
    "minimumTotalSupport": {
      "type": "integer",
      "minimum": 1
    },
    "minimumSliceSupport": {
      "type": "integer",
      "minimum": 1
    },
    "minimumGateBlockingSliceSupport": {
      "type": "integer",
      "minimum": 1
    },
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "levelBps"
      ],
      "properties": {
        "method": {
          "enum": [
            "wilson",
            "exact-binomial"
          ]
        },
        "levelBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        }
      }
    },
    "qualityNonInferiorityBps": {
      "$ref": "#/$defs/bps"
    },
    "efficiencyClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minimumPositiveTotalEconomicsUsd"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimumPositiveTotalEconomicsUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "stringId": {
      "type": "string",
      "minLength": 1
    }
  }
}
