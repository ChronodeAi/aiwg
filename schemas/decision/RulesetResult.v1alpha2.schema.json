              { "properties": { "status": { "enum": ["completed", "defaulted"] } } },
              {
                "properties": { "status": { "const": "review" } },
                "not": { "properties": { "reason": { "const": "insufficient-information" } }, "required": ["reason"] }
              }
            ]
