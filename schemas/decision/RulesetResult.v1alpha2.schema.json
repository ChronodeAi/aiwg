                      "runId": { "type": "string", "minLength": 1 },
                      "requestedAlias": { "type": "string", "minLength": 1 },
                      "actualModel": { "type": "string", "minLength": 1 },
                      "aliasRevision": { "type": ["integer", "null"], "minimum": 1 },
                      "artifactId": { "type": ["string", "null"] },
                      "artifactDigest": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] },
                      "state": { "enum": ["exact", "approved-compatible", "shadow-required", "incompatible", "unknown"] },
                      "action": { "enum": ["allow", "fail", "defer", "shadow", "require-approval"] },
                      "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                      "decidedAt": { "type": "string", "format": "date-time" }
                    },
                    "additionalProperties": false
                  },
                  "batchResult": {
                    "type": "object",
                    "properties": {
                      "schemaVersion": { "const": "decision-batch-result-ref/v1" },
                      "batchId": { "type": "string", "minLength": 1 },
                      "receiptRevision": { "type": "integer", "minimum": 1 },
                      "questionId": { "type": "string", "minLength": 1 },
                      "answerId": { "type": "string", "minLength": 1 }
                    },
                    "required": ["schemaVersion", "batchId", "receiptRevision", "questionId", "answerId"],
