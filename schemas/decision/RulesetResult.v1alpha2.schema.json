                    "then": {
                      "required": [
                        "value"
                      ],
                      "properties": {
                        "value": {},
                        "reason": {
                          "const": "none"
                        },
                        "attempts": {
                          "type": "array",
                          "minItems": 1
                        }
                      }
                    },
                    "else": {
                      "not": {
                        "properties": {
                          "value": {}
                        },
                        "required": [
                          "value"
                        ]
                      },
                      "properties": {
                        "reason": {
                          "not": {
                            "const": "none"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "required": [
