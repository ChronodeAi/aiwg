{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/memory/maintenance-plan.v1.schema.json",
  "title": "AIWG memory maintenance plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aiwg.maintenance-plan.v1"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "lifecycle"
      ],
      "properties": {
        "placement": {
          "$ref": "https://aiwg.io/schemas/memory/memory-taxonomy.v1.schema.json#/$defs/placement"
        },
        "lifecycle": {
          "$ref": "https://aiwg.io/schemas/memory/memory-taxonomy.v1.schema.json#/$defs/lifecycle"
        }
      }
    },
    "targetState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "lifecycle"
      ],
      "properties": {
        "placement": {
          "$ref": "https://aiwg.io/schemas/memory/memory-taxonomy.v1.schema.json#/$defs/placement"
        },
        "lifecycle": {
          "enum": [
            "active",
            "superseded",
            "retired",
            "quarantined"
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target",
        "from",
        "to",
        "scope",
        "rationale",
        "uncertainty",
        "impactedLinks",
        "sessionEffect",
        "precondition"
      ],
      "properties": {
        "op": {
          "enum": [
            "promote",
            "demote",
            "recategorize",
            "merge",
            "split",
            "supersede",
            "retire",
            "restore"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "from": {
          "$ref": "#/$defs/state"
        },
        "to": {
          "$ref": "#/$defs/targetState"
        },
        "scope": {
          "$ref": "https://aiwg.io/schemas/memory/memory-taxonomy.v1.schema.json#/$defs/scope"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "impactedLinks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sessionEffect": {
          "enum": [
            "current",
            "next-session"
          ]
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "version"
          ],
          "properties": {
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "handle",
            "snapshot"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "handle": {
              "type": "string",
              "minLength": 1
            },
            "snapshot": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "retirementBasis"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "retirementBasis": {
              "enum": [
                "age",
                "review"
              ]
            }
          }
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "replacements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "sourcePath": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
