{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/gates/GateReport.v1alpha1.schema.json",
  "title": "GateReport",
  "description": "Experimental, default-off evaluator output for one GateBinding (epic #2824). Records per-gate statistic evidence, the combined decision, the upstream ceiling and its own digest. The decision never upgrades any component: it is the maximum over gates, upstream ceiling and binding ceiling on PROMOTE < HOLD < ROLLBACK.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "binding", "packs", "metricProviders",
    "metricsDigest", "holdout", "gateEvidence", "references", "upstream", "ceilings", "decision", "evaluatedAt", "digest"],
  "properties": {
    "apiVersion": { "const": "gates.aiwg.io/v1alpha1" },
    "kind": { "const": "GateReport" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "binding": { "$ref": "#/$defs/artifactPin" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packPin" }
    },
    "metricProviders": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metricProviderPin" }
    },
    "metricsDigest": { "$ref": "#/$defs/digest" },
    "holdout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "frozenDigest", "firstAccessedAt"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "frozenDigest": { "$ref": "#/$defs/digest" },
        "firstAccessedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "gateEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gateEvidence" }
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/referenceEvidence" }
    },
    "upstream": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["decision", "reasons", "digest"],
      "properties": {
        "decision": { "enum": ["PROMOTE", "HOLD", "ROLLBACK"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packOutcome", "upstreamCeiling", "bindingCeiling"],
      "properties": {
        "packOutcome": { "enum": ["PROMOTE", "HOLD", "ROLLBACK"] },
        "upstreamCeiling": { "enum": ["PROMOTE", "HOLD", "ROLLBACK"] },
        "bindingCeiling": { "enum": ["PROMOTE", "HOLD", "ROLLBACK"] }
      }
    },
    "decision": { "enum": ["PROMOTE", "HOLD", "ROLLBACK"] },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "attestation": { "const": "offline-cli", "description": "Present only on reports produced by the offline CLI over caller-asserted files." },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "packPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "resolvedDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "digest": { "$ref": "#/$defs/digest" },
        "resolvedDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "metricProviderPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sourceDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "statisticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "enum": ["wilson", "clopper-pearson", "newcombe", "tango", "bootstrap", "exact-count", "exact-value", "evidence-present", "predicate", "upstream-integrity", "support-count"] },
        "levelBps": { "type": ["integer", "null"] },
        "lowerBps": { "type": ["integer", "null"] },
        "upperBps": { "type": ["integer", "null"] },
        "estimateBps": { "type": ["integer", "null"] }
      }
    },
    "thresholdEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "resolved"],
      "properties": {
        "op": { "enum": ["lte", "gte"] },
        "value": { "type": "number" },
        "param": { "type": "string" },
        "resolved": { "type": "number" }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "kind", "scope", "slice", "n", "status", "outcome", "reasons"],
      "properties": {
        "gateId": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["interval-bound", "paired-difference", "bootstrap-bound", "count-max", "count-min",
            "value-threshold", "minimum-n", "evidence", "predicate", "upstream-ceiling"]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["all", "each", "listed", "pooled"] },
            "slices": { "type": "array", "items": { "type": "string" } }
          }
        },
        "slice": { "type": ["string", "null"] },
        "n": { "type": ["integer", "null"], "minimum": 0 },
        "events": { "type": ["integer", "null"], "minimum": 0 },
        "statistic": { "$ref": "#/$defs/statisticEvidence" },
        "threshold": { "$ref": "#/$defs/thresholdEvidence" },
        "status": { "enum": ["pass", "fail", "insufficient"] },
        "outcome": { "enum": ["PROMOTE", "HOLD", "ROLLBACK"] },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "referenceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "observed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["always-review", "always-predict", "pinned-baseline"] },
        "observed": { "type": "boolean" }
      }
    }
  }
}
