{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/kairos/v1/edge-proposal.schema.json",
  "title": "Kairos edge proposal",
  "description": "One proposer's candidate edge. A proposal is never an admitted edge: it is written to .aiwg/kairos/proposals/ and reaches the node only after the evidence gates return auto_promote or a review packet records an approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recorded_at",
    "edge_id",
    "proposer",
    "source",
    "target",
    "vector_type",
    "sign",
    "mechanism",
    "falsifier",
    "sources",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "kairos_edge_proposal/v1"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    },
    "edge_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "description": "Stable across proposers: <project>.<source-slug>.<causes|reduces>.<target-slug>."
    },
    "proposer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "description": "Independence class for gate EA-G2: llm:<vendor>, statistical:<method>, domain-rule or human:<team>."
        },
        "kind": {
          "type": "string",
          "enum": [
            "llm",
            "statistical",
            "domain_rule",
            "human"
          ]
        },
        "model": {
          "type": "string",
          "description": "Model or method identifier as reported by the runtime; never guessed."
        },
        "method_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "sha256"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/definitions/sha256"
            }
          }
        }
      }
    },
    "source": {
      "$ref": "#/definitions/node"
    },
    "target": {
      "$ref": "#/definitions/node"
    },
    "vector_type": {
      "type": "string",
      "enum": [
        "structural",
        "contextual",
        "causal",
        "adaptive",
        "behavioral"
      ]
    },
    "sign": {
      "type": "string",
      "enum": [
        "positive",
        "negative"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "description": "Context-gating parameters, limited to the public resolve context fields.",
      "properties": {
        "user": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "roles": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "locale": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "timestamp": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        }
      }
    },
    "lag": {
      "type": "string",
      "description": "ISO 8601 duration between cause and effect; feedback is a lagged edge, never a cycle."
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "falsifier": {
      "type": "string",
      "minLength": 1,
      "description": "The observation that would refute the edge."
    },
    "confidence_text": {
      "type": "string",
      "description": "The proposer's confidence in words. Never a node weight."
    },
    "new_node_type": {
      "type": "boolean"
    },
    "touches_live_money": {
      "type": "boolean"
    },
    "policy_touching": {
      "type": "boolean"
    },
    "signing_or_capital_policy": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/definitions/sha256"
          },
          "as_of": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "const": "candidate"
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_id",
        "idempotency_key"
      ],
      "description": "Present only when the pilot plan enables the role-gated candidate mirror.",
      "properties": {
        "vector_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "namespace",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
