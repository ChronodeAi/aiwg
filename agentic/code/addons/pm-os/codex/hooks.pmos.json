{
  "description": "Generated by bin/generate-codex-adapters.py; do not edit. PMOS lifecycle adapters.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{PMOS_SESSION_START_COMMAND}}",
            "timeout": 10,
            "statusMessage": "Checking PMOS context reminders",
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "{{PMOS_SAVE_GUARD_COMMAND}}",
            "timeout": 10,
            "statusMessage": "Validating PMOS document destination",
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
